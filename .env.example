# ── Entorno ──────────────────────────────────────────────
# true en local (muestra errores), false en producción
APP_DEBUG=false
# '/api' en producción (HestiaCP); vacío en local
APP_BASE_PATH=/api
# true = JWT solo por HTTPS (producción). false en local (HTTP)
APP_SECURE=true

# ── Autenticación JWT (validación únicamente) ────────────
AUTH_ENABLED=true
# Secreto compartido (mínimo 32 caracteres). Este servicio NO emite tokens: la
# autenticación la hace hal-auth. Debe coincidir con hal-auth-api y hal-archivos-api.
JWT_SECRET=

# ── CORS (orígenes del frontend, separados por coma) ─
CORS_ORIGINS=https://hospitalantoniolorena.gob.pe,https://www.hospitalantoniolorena.gob.pe,https://oficinas.hospitalantoniolorena.gob.pe

# ── Base de datos MySQL ───────────────
DB_HOST=localhost
DB_NAME=haladminweb_oficinas_db
DB_USER=haladminweb_oficinas_db
DB_PASS=

# ── Servicio de archivos (hal-archivos-api, dominio principal) ──
# Borrado servidor-a-servidor: la API reenvía DELETE al microservicio
# (endpoint /oficinas/delete de la colección "oficinas").
FILES_API_BASE_URL=https://hospitalantoniolorena.gob.pe/files-api
# URL pública base para construir enlaces de descarga de los archivos.
ARCHIVOS_BASE_URL=https://hospitalantoniolorena.gob.pe/oficinas
test="test"